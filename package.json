{
  "name": "gharka",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate --filter=@gharka/api",
    "db:migrate": "turbo run db:migrate --filter=@gharka/api",
    "db:push": "turbo run db:push --filter=@gharka/api"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "~5.4.5"
  }
}
